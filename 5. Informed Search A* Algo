Greedy best first search


import heapq

# Distance between cities
cities = ['A', 'B', 'C', 'D']

dist = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

# Greedy Best First Search
def greedy_best_first_search(start):
    pq = []
    heapq.heappush(pq, (0, start, [start]))

    total_cost = 0

    while pq:
        h, current, path = heapq.heappop(pq)

        # Check if all cities are visited
        if len(path) == len(cities):
            path.append(start)
            total_cost = sum(
                dist[cities.index(path[i])][cities.index(path[i + 1])]
                for i in range(len(path) - 1)
            )

            return path, total_cost

        # Explore unvisited cities
        for next_city in cities:
            if next_city not in path:
                heuristic = dist[cities.index(current)][cities.index(next_city)]

                heapq.heappush(
                    pq,
                    (heuristic, next_city, path + [next_city])
                )

    return None, 0


# Main program
path, cost = greedy_best_first_search('A')

print("Path:", " -> ".join(path))
print("Total Cost:", cost)
