
# A* Algorithm for Travelling Salesman Problem

import heapq

# Distance between cities
cities = ['A', 'B', 'C', 'D']

dist = [
    [0, 10, 15, 20],
    [10, 0, 35, 25],
    [15, 35, 0, 30],
    [20, 25, 30, 0]
]

n = len(cities)


# Calculate Minimum Spanning Tree cost
def mst_cost(nodes):

    if len(nodes) <= 1:
        return 0

    visited = {nodes[0]}
    cost = 0

    while len(visited) < len(nodes):

        best = float('inf')
        next_node = None

        for u in visited:
            for v in nodes:
                if v not in visited and dist[u][v] < best:
                    best = dist[u][v]
                    next_node = v

        cost += best
        visited.add(next_node)

    return cost


# Heuristic function
def heuristic(current, mask):

    remaining = [i for i in range(n)
                 if not (mask & (1 << i))]

    if not remaining:
        return dist[current][0]

    connect_start = min(dist[0][i] for i in remaining)

    connect_current = min(dist[current][i]
                          for i in remaining)

    return (connect_current +
            mst_cost(remaining) +
            connect_start)


# A* Search Algorithm
def astar_tsp():

    start = 0
    mask = 1 << start

    pq = [(heuristic(start, mask), 0, start, mask, [start])]

    best_cost = {(start, mask): 0}

    while pq:

        f, g, current, mask, path = heapq.heappop(pq)

        if g != best_cost.get((current, mask)):
            continue

        # Check whether all cities are visited
        if mask == (1 << n) - 1:

            total = g + dist[current][start]

            return path + [start], total

        # Explore unvisited cities
        for next_city in range(n):

            if not (mask & (1 << next_city)):

                new_g = g + dist[current][next_city]
                new_mask = mask | (1 << next_city)

                state = (next_city, new_mask)

                if new_g < best_cost.get(state, float('inf')):

                    best_cost[state] = new_g

                    new_f = new_g + heuristic(next_city, new_mask)

                    heapq.heappush(
                        pq,
                        (new_f, new_g, next_city,
                         new_mask, path + [next_city])
                    )

    return None, float('inf')


# Main program
path, cost = astar_tsp()

if path:
    print("Shortest Route:")

    print(" -> ".join(cities[i] for i in path))

    print("Total Distance:", cost)

else:
    print("No tour found!")








