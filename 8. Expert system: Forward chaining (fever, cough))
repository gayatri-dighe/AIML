
# Rule-Based Expert System using Forward Chaining

# Take initial facts from user
facts = set()

print("EXPERT SYSTEM - FORWARD CHAINING")
print("Enter symptoms (yes/no):")

fever = input("Do you have fever? ").lower()
cough = input("Do you have cough? ").lower()
headache = input("Do you have headache? ").lower()

# Store initial facts
if fever == "yes":
    facts.add("fever")

if cough == "yes":
    facts.add("cough")

if headache == "yes":
    facts.add("headache")


# Five propositional rules
rules = [
    ({"fever", "cough"}, "flu"),
    ({"flu"}, "weakness"),
    ({"fever", "headache"}, "infection"),
    ({"infection", "weakness"}, "need_rest"),
    ({"need_rest"}, "consult_doctor")
]

# Forward Chaining
print("\nInitial Facts:", facts)
print("\nForward Chaining Process:")

while True:

    new_fact_found = False

    for conditions, conclusion in rules:

        if conditions.issubset(facts):

            if conclusion not in facts:

                facts.add(conclusion)

                print("New Fact Derived:", conclusion)

                new_fact_found = True

    if not new_fact_found:
        break


# Display final facts
print("\nFinal Facts:")

for fact in sorted(facts):
    print(fact)

print("\nForward Chaining Completed!")
