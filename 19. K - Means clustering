1. Import libraries

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.cluster import KMeans
from scipy.cluster.hierarchy import dendrogram, linkage


2. Download dataset

url = "https://raw.githubusercontent.com/shwetabhardwaj007/Mall-Customer-Segmentation/master/Mall_Customers.csv"

df = pd.read_csv(url)

print("Mall Customers Dataset:")
print(df.head())



3. Select Anjual income and spending score

X = df[['Annual Income (k$)', 'Spending Score (1-100)']]

print(X.head())



4. Elbow Method

inertia = []

for k in range(1, 11):
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    kmeans.fit(X)

    inertia.append(kmeans.inertia_)

print("Inertia Values:", inertia)





5. Plot Elbow curve

plt.plot(range(1, 11), inertia, marker='o')

plt.xlabel('Number of Clusters (K)')
plt.ylabel('Inertia')
plt.title('Elbow Method')

plt.show()


6. Dendrogram

linked = linkage(X, method='ward')

plt.figure(figsize=(12, 6))

dendrogram(linked)

plt.title('Dendrogram')
plt.xlabel('Customers')
plt.ylabel('Euclidean Distance')

plt.show()


7. Apply K - Means clustering

kmeans = KMeans(n_clusters=5, random_state=42, n_init=10)

df['Cluster'] = kmeans.fit_predict(X)

print(df[['Annual Income (k$)', 'Spending Score (1-100)', 'Cluster']].head())



8. Get cluster entroids

centroids = kmeans.cluster_centers_

print("Cluster Centroids:")
print(centroids)



9. Plot clusters with centroids

plt.figure(figsize=(10, 6))

plt.scatter(
    X['Annual Income (k$)'],
    X['Spending Score (1-100)'],
    c=df['Cluster'],
    cmap='rainbow',
    s=50
)

plt.scatter(
    centroids[:, 0],
    centroids[:, 1],
    color='black',
    marker='X',
    s=200,
    label='Centroids'
)

plt.xlabel('Annual Income (k$)')
plt.ylabel('Spending Score (1-100)')
plt.title('K-Means Customer Clustering')
plt.legend()

plt.show()




10. Analyze generated clusters

print("Cluster Analysis:")

print(
    df.groupby('Cluster')[
        ['Annual Income (k$)', 'Spending Score (1-100)']
    ].mean()
)
